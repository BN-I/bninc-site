f9" class="sc-jtRlXQ dmtFAn"><div class="sc-bnXvFD bjVnbr"><div class="sc-gJWqzi fStFLo"><p class="MuiTypography-root MuiTypography-body1 css-5r6nnz">TESTIMONIALS</p><h4 class="MuiTypography-root MuiTypography-h4 css-1jopgkv">What our clients say</h4></div><div class="sc-hGoxap gFwwra"><div class="sc-fjmCvl lnzaNZ"><div style="display:flex;justify-content:center;align-items:center;flex-direction:column;opacity:0;transform:translateX(50px)"><div><svg class="sc-laTMn HUaaV MuiBox-root css-0" width="20" height="19" viewBox="0 0 20 19" fill="none"><path d="M10 0L12.2451 6.90983H19.5106L13.6327 11.1803L15.8779 18.0902L10 13.8197L4.12215 18.0902L6.36729 11.1803L0.489435 6.90983H7.75486L10 0Z" fill="#38A6FB"></path></svg><svg class="sc-laTMn HUaaV MuiBox-root css-0" width="20" height="19" viewBox="0 0 20 19" fill="none"><path d="M10 0L12.2451 6.90983H19.5106L13.6327 11.1803L15.8779 18.0902L10 13.8197L4.12215 18.0902L6.36729 11.1803L0.489435 6.90983H7.75486L10 0Z" fill="#38A6FB"></path></svg><svg class="sc-laTMn HUaaV MuiBox-root css-0" width="20" height="19" viewBox="0 0 20 19" fill="none"><path d="M10 0L12.2451 6.90983H19.5106L13.6327 11.1803L15.8779 18.0902L10 13.8197L4.12215 18.0902L6.36729 11.1803L0.489435 6.90983H7.75486L10 0Z" fill="#38A6FB"></path></svg><svg class="sc-laTMn HUaaV MuiBox-root css-0" width="20" height="19" viewBox="0 0 20 19" fill="none"><path d="M10 0L12.2451 6.90983H19.5106L13.6327 11.1803L15.8779 18.0902L10 13.8197L4.12215 18.0902L6.36729 11.1803L0.489435 6.90983H7.75486L10 0Z" fill="#38A6FB"></path></svg><svg class="sc-laTMn HUaaV MuiBox-root css-0" width="20" height="19" viewBox="0 0 20 19" fill="none"><path d="M10 0L12.2451 6.90983H19.5106L13.6327 11.1803L15.8779 18.0902L10 13.8197L4.12215 18.0902L6.36729 11.1803L0.489435 6.90983H7.75486L10 0Z" fill="#38A6FB"></path></svg><div class="sc-jzgbtB EJaxL"><p class="MuiTypography-root MuiTypography-body1 css-1e9bq5b">&quot;My wife and I are very pleased with how smooth our real estate transaction went all the way through closing with Propy Title and Escrow. From submitting the details online to meeting with the notary at our home to sign the paperwork and getting funded within a matter of a few hours, it was all a great experience and we highly recommend them for your title needs.&quot;</p></div></div><div><p class="MuiTypography-root MuiTypography-body1 sc-rBLzX hgKvKh css-sjbcqh">Oscar Bidopia</p><p class="MuiTypography-root MuiTypography-body1 sc-bMvGRv emftib css-msk86k">Seller</p></div></div></div></div><div class="sc-TFwJa Gommx"><button class="MuiButtonBase-root Mui-disabled MuiIconButton-root Mui-disabled MuiIconButton-sizeMedium css-y9m7lm" tabindex="-1" type="button" disabled aria-label="backwards"><svg class="MuiBox-root css-ac5h65" width="21" height="8" viewBox="0 0 21 8" fill="none"><path d="M20.7402 3.20854L20.7402 4.50214L6.29944 4.50214L6.29944 7.30054L0.359438 3.86854L6.29944 0.410136L6.29944 3.20854L20.7402 3.20854Z" fill="#38A6FB"></path></svg></button><button class="MuiButtonBase-root MuiIconButton-root MuiIconButton-sizeMedium css-jus0ll" tabindex="0" type="button" aria-label="forwards"><svg class="MuiBox-root css-sffry1" width="21" height="8" viewBox="0 0 21 8" fill="none"><path d="M20.7402 3.20854L20.7402 4.50214L6.29944 4.50214L6.29944 7.30054L0.359438 3.86854L6.29944 0.410136L6.29944 3.20854L20.7402 3.20854Z" fill="#38A6FB"></path></svg></button></div></div></div><div class="sc-jtRlXQ dmtFAn"><div class="sc-bHwgHz hWhLsq"><div class="sc-krDsej ypXIs"><div class="sc-dTdPqK kOOEgT"><p class="MuiTypography-root MuiTypography-body1 css-1voymic">INVESTORS &amp; ADVISERS</p><div class="sc-itybZL cIJeaj"><h4 class="MuiTypography-root MuiTypography-h4 css-kisncr">Our investors and advisers are some of the smartest people in real estate, technology and investment.</h4></div></div><div class="sc-eMigcr zHSti"><div class="sc-fzsDOv fRqWUv"><div class="sc-gPWkxV fuyyvC"><div data-gatsby-image-wrapper="" style="width:100%;height:100%" class="gatsby-i